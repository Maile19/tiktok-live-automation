[Unit]
Description=TikTok Live Automation & Dashboard Engine
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/tiktok-live-automation
ExecStart=/usr/bin/python3 /home/ubuntu/tiktok-live-automation/dashboard_engine.py
Restart=always
RestartSec=3s
KillMode=mixed
TimeoutStopSec=10
Environment=PORT=8088
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
